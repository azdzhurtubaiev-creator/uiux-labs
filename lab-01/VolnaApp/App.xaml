<Application x:Class="VolnaApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="SplashWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Logo.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="BgColor">#141019</Color>
            <Color x:Key="TextColor">#F5F3FA</Color>
            <Color x:Key="AccentColor">#A78BFA</Color>
            <Color x:Key="MutedColor">#9C96AD</Color>

            <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
            <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
            <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>