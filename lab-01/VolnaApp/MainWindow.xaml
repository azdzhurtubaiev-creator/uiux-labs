<Window x:Class="VolnaApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Volna - про застосунок"
        Height="560" Width="760"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">

    <Grid Margin="48">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Image Grid.Column="0"
               Source="{StaticResource LogoImage}"
               Width="200" Height="200"
               VerticalAlignment="Top"
               RenderOptions.BitmapScalingMode="HighQuality"/>

        <StackPanel Grid.Column="1" Margin="40,0,0,0" VerticalAlignment="Top">

            <TextBlock Text="volna"
                       FontSize="44"
                       FontWeight="Medium"
                       Foreground="{StaticResource TextBrush}"/>

            <TextBlock Text="Підбір музики під настрій та активність"
                       FontSize="16"
                       Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"/>

            <Border Height="1" Background="#2A2433" Margin="0,28,0,24"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Версія"
                           Foreground="{StaticResource MutedBrush}" FontSize="15" Margin="0,0,0,12"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="1.0.0"
                           Foreground="{StaticResource TextBrush}" FontSize="15" Margin="0,0,0,12"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Автор"
                           Foreground="{StaticResource MutedBrush}" FontSize="15" Margin="0,0,0,12"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="Арсен Джуртубаєв"
                           Foreground="{StaticResource TextBrush}" FontSize="15" Margin="0,0,0,12"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Група"
                           Foreground="{StaticResource MutedBrush}" FontSize="15" Margin="0,0,0,12"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="621п, КБ 603, ХАІ"
                           Foreground="{StaticResource TextBrush}" FontSize="15" Margin="0,0,0,12"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Рік"
                           Foreground="{StaticResource MutedBrush}" FontSize="15"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="2026"
                           Foreground="{StaticResource TextBrush}" FontSize="15"/>
            </Grid>

            <Border Background="#1C1724"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,32,0,0">
                <StackPanel>
                    <TextBlock Text="Палітра"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="13"
                               Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="8" Background="#141019"
                                BorderBrush="#2A2433" BorderThickness="1" Margin="0,0,10,0"/>
                        <Border Width="36" Height="36" CornerRadius="8" Background="#F5F3FA" Margin="0,0,10,0"/>
                        <Border Width="36" Height="36" CornerRadius="8" Background="#A78BFA" Margin="0,0,10,0"/>
                        <Border Width="36" Height="36" CornerRadius="8" Background="#9C96AD"/>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
</Window>