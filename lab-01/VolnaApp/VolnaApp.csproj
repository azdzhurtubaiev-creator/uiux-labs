<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <AssemblyName>VolnaApp</AssemblyName>
    <RootNamespace>VolnaApp</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Assets\logo.svg" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\logo-wordmark.svg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>